page {
  height: 100vh;
  background: #f6f7f9;
}

.page {
  height: 100vh;
  padding: 32rpx 24rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #111827;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.home-button {
  min-width: 88rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #111827;
  font-size: 26rpx;
  color: #ffffff;
}

.add-card {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.table-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: #f6f7f9;
  font-size: 28rpx;
}

.add-button {
  width: 168rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: #111827;
  font-size: 26rpx;
  color: #ffffff;
}

.hint {
  margin: 20rpx 0;
  padding: 20rpx 24rpx;
  border-left: 8rpx solid #ea580c;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4b5563;
}

.table-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.table-card {
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.table-main {
  margin-bottom: 20rpx;
}

.table-no {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #111827;
}

.table-path {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.table-actions {
  display: flex;
  gap: 16rpx;
}

.scan-button,
.toggle-button {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.scan-button {
  background: #22c55e;
  color: #052e16;
}

.scan-button[disabled] {
  background: #d1d5db;
  color: #6b7280;
}

.toggle-button {
  background: #fff7ed;
  color: #9a3412;
}

.toggle-disabled {
  background: #e8f5ee;
  color: #166534;
}
