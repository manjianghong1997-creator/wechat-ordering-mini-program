page {
  height: 100vh;
  background: #f6f7f9;
}

.page {
  height: 100vh;
  padding: 32rpx 24rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #111827;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.home-button {
  min-width: 88rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #111827;
  font-size: 26rpx;
  color: #ffffff;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.metric-card {
  min-height: 156rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.revenue-card {
  background: #e8f5ee;
}

.metric-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
}

.metric-value {
  display: block;
  margin-top: 20rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: #111827;
}

.section {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.status-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.status-row {
  display: grid;
  grid-template-columns: 96rpx 1fr 56rpx;
  align-items: center;
  gap: 18rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.bar-track {
  height: 18rpx;
  overflow: hidden;
  border-radius: 9rpx;
  background: #eef1f5;
}

.bar {
  height: 18rpx;
  border-radius: 9rpx;
}

.bar-pending {
  background: #f59e0b;
}

.bar-cooking {
  background: #2563eb;
}

.bar-done {
  background: #22c55e;
}

.status-count {
  text-align: right;
  color: #111827;
}

.empty {
  padding: 32rpx;
  border-radius: 8rpx;
  background: #f6f7f9;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}

.rank-list {
  display: flex;
  flex-direction: column;
}

.rank-row {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.rank-row:last-child {
  border-bottom: 0;
}

.rank-left,
.rank-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rank-left {
  flex: 1;
  min-width: 0;
}

.rank-index {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 21rpx;
  background: #111827;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

.rank-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.rank-right {
  flex: 0 0 auto;
  font-size: 26rpx;
  color: #4b5563;
}

.rank-amount {
  min-width: 92rpx;
  text-align: right;
  font-weight: 700;
  color: #dc2626;
}
