page {
  min-height: 100vh;
  background: #f6f7f9;
}

.page {
  min-height: calc(100vh - 132rpx);
  padding: 24rpx 24rpx 160rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #111827;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.clear-button {
  min-width: 104rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #dc2626;
}

.empty {
  margin-top: 160rpx;
  padding: 48rpx 32rpx;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.empty-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.back-button {
  width: 200rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx auto 0;
  border-radius: 34rpx;
  background: #111827;
  font-size: 28rpx;
  color: #ffffff;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.item-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.item-price {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #dc2626;
}

.item-actions {
  width: 204rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.count-button {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: #eef1f5;
  font-size: 32rpx;
  color: #111827;
}

.item-count {
  width: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.delete-button {
  width: 128rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: #fee2e2;
  font-size: 24rpx;
  color: #b91c1c;
}

.footer {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx 18rpx 28rpx;
  border-radius: 8rpx;
  background: #111827;
  box-shadow: 0 16rpx 36rpx rgba(17, 24, 39, 0.22);
}

.footer-count {
  display: block;
  font-size: 24rpx;
  color: #d1d5db;
}

.footer-total {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.submit-button {
  min-width: 176rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  background: #22c55e;
  font-size: 28rpx;
  font-weight: 700;
  color: #052e16;
}
