page {
  height: 100vh;
  background: #f6f7f9;
}

.page {
  height: 100vh;
  padding: 32rpx 24rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #111827;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.clear-button {
  min-width: 104rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #dc2626;
}

.header-actions {
  display: flex;
  gap: 12rpx;
}

.home-button {
  min-width: 88rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #111827;
  font-size: 26rpx;
  color: #ffffff;
}

.stats-button {
  min-width: 88rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #e8f5ee;
  font-size: 26rpx;
  color: #166534;
}

.empty {
  margin-top: 160rpx;
  padding: 48rpx 32rpx;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.empty-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.back-button {
  width: 200rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx auto 0;
  border-radius: 34rpx;
  background: #111827;
  font-size: 28rpx;
  color: #ffffff;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.order-top,
.summary,
.food-row,
.actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.order-id {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.order-time {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.status {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.status-pending {
  background: #fef3c7;
  color: #92400e;
}

.status-cooking {
  background: #dbeafe;
  color: #1d4ed8;
}

.status-done {
  background: #dcfce7;
  color: #166534;
}

.summary {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: #f6f7f9;
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

.items {
  margin-top: 18rpx;
}

.food-row {
  min-height: 48rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.food-name {
  flex: 1;
}

.food-count {
  color: #111827;
}

.actions {
  justify-content: flex-end;
  margin-top: 20rpx;
}

.action-button {
  min-width: 152rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: #111827;
  font-size: 26rpx;
  color: #ffffff;
}

.done-button {
  background: #22c55e;
  color: #052e16;
}
