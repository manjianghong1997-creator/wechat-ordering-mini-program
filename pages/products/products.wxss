page {
  height: 100vh;
  background: #f6f7f9;
}

.page {
  height: 100vh;
  padding: 32rpx 24rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #111827;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.home-button {
  min-width: 88rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #111827;
  font-size: 26rpx;
  color: #ffffff;
}

.form-card {
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.input {
  height: 72rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: #f6f7f9;
  font-size: 28rpx;
}

.picker-row {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: #f6f7f9;
  font-size: 28rpx;
  color: #111827;
}

.save-button {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  border-radius: 38rpx;
  background: #111827;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.category-tabs {
  display: flex;
  gap: 14rpx;
  margin: 24rpx 0;
  overflow-x: auto;
}

.category-tab {
  min-width: 120rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #4b5563;
}

.category-active {
  background: #111827;
  color: #ffffff;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.product-item {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.product-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.product-price {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #dc2626;
}

.product-actions {
  width: 136rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
}

.status {
  padding: 8rpx 14rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.status-on {
  background: #dcfce7;
  color: #166534;
}

.status-off {
  background: #fee2e2;
  color: #b91c1c;
}

.toggle-button {
  width: 116rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #eef2ff;
  font-size: 26rpx;
  color: #3730a3;
}
