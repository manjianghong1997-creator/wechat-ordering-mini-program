page {
  height: 100vh;
  background: #f6f7f9;
}

.page {
  height: 100vh;
  padding: 32rpx 24rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #111827;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.home-button {
  min-width: 88rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #111827;
  font-size: 26rpx;
  color: #ffffff;
}

.add-card {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.category-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: #f6f7f9;
  font-size: 28rpx;
}

.add-button {
  width: 168rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: #111827;
  font-size: 26rpx;
  color: #ffffff;
}

.hint {
  margin: 20rpx 0;
  padding: 20rpx 24rpx;
  border-left: 8rpx solid #0284c7;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4b5563;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.category-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.category-main {
  flex: 1;
  min-width: 0;
}

.category-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.category-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.category-actions {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 18rpx;
}

.status {
  padding: 8rpx 14rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.status-on {
  background: #dcfce7;
  color: #166534;
}

.status-off {
  background: #fee2e2;
  color: #b91c1c;
}

.toggle-button {
  width: 116rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #f0f9ff;
  font-size: 26rpx;
  color: #075985;
}
