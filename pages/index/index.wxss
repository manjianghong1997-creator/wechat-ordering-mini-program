page {
  height: 100vh;
}

.page {
  height: calc(100vh - 128rpx);
  padding: 24rpx 24rpx 32rpx;
}

.shop-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.shop-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.shop-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.table-badge {
  min-width: 128rpx;
  padding: 16rpx 18rpx;
  border-radius: 8rpx;
  background: #1f2933;
  text-align: center;
}

.home-button {
  width: 88rpx;
  height: 56rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #eef1f5;
  font-size: 24rpx;
  color: #111827;
}

.table-label {
  display: block;
  font-size: 22rpx;
  color: #d1d5db;
}

.table-number {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.notice {
  margin: 20rpx 0;
  padding: 20rpx 24rpx;
  border-left: 8rpx solid #2f855a;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #4b5563;
}

.menu-layout {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.category-list {
  width: 164rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #eef1f5;
}

.category-item {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  font-size: 28rpx;
  color: #4b5563;
}

.category-active {
  background: #ffffff;
  color: #111827;
  font-weight: 700;
}

.product-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.product-photo {
  width: 144rpx;
  height: 144rpx;
  flex: 0 0 144rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.photo-red {
  background: #c2410c;
}

.photo-green {
  background: #2f855a;
}

.photo-yellow {
  background: #b7791f;
}

.photo-blue {
  background: #2563eb;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.product-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.product-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #dc2626;
}

.add-button {
  min-width: 96rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #111827;
  font-size: 26rpx;
  color: #ffffff;
}

.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx 18rpx 28rpx;
  border-radius: 8rpx;
  background: #111827;
  box-shadow: 0 16rpx 36rpx rgba(17, 24, 39, 0.22);
}

.cart-count {
  display: block;
  font-size: 24rpx;
  color: #d1d5db;
}

.cart-total {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.submit-button {
  min-width: 176rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  background: #22c55e;
  font-size: 28rpx;
  font-weight: 700;
  color: #052e16;
}

.submit-disabled {
  background: #6b7280;
  color: #d1d5db;
}
