<view class="page">
  <view class="result">
    <view class="success-icon">✓</view>
    <text class="title">订单已提交</text>
    <text class="desc">后厨已收到订单，请在座位上稍等。</text>
  </view>

  <view class="order-card">
    <view class="order-row">
      <text class="label">订单号</text>
      <text class="value">{{order.id}}</text>
    </view>
    <view class="order-row">
      <text class="label">桌号</text>
      <text class="value">{{order.tableNo}}</text>
    </view>
    <view class="order-row">
      <text class="label">状态</text>
      <text class="status">{{order.statusText}}</text>
    </view>
    <view class="order-row">
      <text class="label">下单时间</text>
      <text class="value">{{order.createdAt}}</text>
    </view>
  </view>

  <view class="items-card">
    <text class="section-title">商品明细</text>
    <view wx:for="{{order.items}}" wx:key="id" class="item-row">
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-count">x {{item.count}}</text>
      </view>
      <text class="item-price">￥{{item.price * item.count}}</text>
    </view>
    <view class="total-row">
      <text>共 {{order.totalCount}} 件</text>
      <text class="total-price">合计 ￥{{order.totalAmount}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="primary-button" bindtap="backToMenu">继续点单</button>
    <button class="secondary-button" bindtap="viewOrders">查看订单</button>
  </view>
</view>
