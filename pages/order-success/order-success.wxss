page {
  min-height: 100vh;
  background: #f6f7f9;
}

.page {
  min-height: 100vh;
  padding: 40rpx 24rpx;
}

.result {
  padding: 48rpx 24rpx 36rpx;
  text-align: center;
}

.success-icon {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  border-radius: 52rpx;
  background: #22c55e;
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #111827;
}

.desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.order-card,
.items-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.order-row {
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  font-size: 26rpx;
}

.label {
  color: #6b7280;
}

.value {
  max-width: 430rpx;
  text-align: right;
  color: #111827;
}

.status {
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: #fef3c7;
  font-size: 24rpx;
  color: #92400e;
}

.section-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.item-count {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.item-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #dc2626;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 22rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.total-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #dc2626;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.primary-button,
.secondary-button {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-button {
  background: #111827;
  color: #ffffff;
}

.secondary-button {
  background: #ffffff;
  color: #111827;
}
